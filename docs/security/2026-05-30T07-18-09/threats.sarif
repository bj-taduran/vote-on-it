          "rules": [
            {
              "id": "tachi/stride/spoofing",
              "shortDescription": { "text": "Identity spoofing threats" },
              "fullDescription": { "text": "Threats where an attacker assumes the identity of another user, system, or component to gain unauthorized access or perform unauthorized actions. Applies to external entities and processes." },
              "help": {
                "text": "Review authentication mechanisms, token validation, UUID generation security, and identity verification at all trust boundaries.",
                "markdown": "## Spoofing Threats\n\nReview authentication mechanisms, token validation, UUID generation security, and identity verification at all trust boundaries.\n\n**References**: OWASP A07 (Identification and Authentication Failures), CWE-287 (Improper Authentication), CWE-290 (Authentication Bypass by Spoofing)"
              },
              "properties": {
                "tags": ["security", "stride", "spoofing", "authentication", "owasp", "cwe"],
                "security-severity": "9.0"
              },
              "relationships": [
                { "target": { "id": "A07", "toolComponent": { "name": "OWASP" } }, "kinds": ["relevant"] },
                { "target": { "id": "CWE-287", "toolComponent": { "name": "CWE" } }, "kinds": ["relevant"] }
              ]
            },
            {
              "id": "tachi/stride/tampering",
              "shortDescription": { "text": "Data tampering threats" },
              "fullDescription": { "text": "Threats where an attacker modifies data, code, or configuration to alter system behavior or corrupt data integrity. Applies to processes, data stores, and data flows." },
              "help": {
                "text": "Review data validation, integrity controls, IAM least-privilege enforcement, and input handling at all processing points.",
                "markdown": "## Tampering Threats\n\nReview data validation, integrity controls, IAM least-privilege enforcement, and input handling at all processing points.\n\n**References**: OWASP A08 (Software and Data Integrity Failures), CWE-345 (Insufficient Verification of Data Authenticity)"
              },
              "properties": {
                "tags": ["security", "stride", "tampering", "integrity", "owasp", "cwe"],
                "security-severity": "9.0"
              },
              "relationships": [
                { "target": { "id": "A08", "toolComponent": { "name": "OWASP" } }, "kinds": ["relevant"] },
                { "target": { "id": "CWE-345", "toolComponent": { "name": "CWE" } }, "kinds": ["relevant"] }
              ]
            },
            {
              "id": "tachi/stride/repudiation",
              "shortDescription": { "text": "Repudiation threats" },
              "fullDescription": { "text": "Threats where an attacker or user denies performing an action, exploiting gaps in audit trails, logging completeness, or non-repudiation controls." },
              "help": {
                "text": "Review audit logging completeness, log format specification, correlation ID propagation, and forensic reconstruction capability.",
                "markdown": "## Repudiation Threats\n\nReview audit logging completeness, log format specification, correlation ID propagation, and forensic reconstruction capability.\n\n**References**: OWASP A09 (Security Logging and Monitoring Failures), CWE-778 (Insufficient Logging)"
              },
              "properties": {
                "tags": ["security", "stride", "repudiation", "logging", "audit", "owasp", "cwe"],
                "security-severity": "5.0"
              },
              "relationships": [
                { "target": { "id": "A09", "toolComponent": { "name": "OWASP" } }, "kinds": ["relevant"] },
                { "target": { "id": "CWE-778", "toolComponent": { "name": "CWE" } }, "kinds": ["relevant"] }
              ]
            },
            {
              "id": "tachi/stride/information-disclosure",
              "shortDescription": { "text": "Information disclosure threats" },
              "fullDescription": { "text": "Threats where sensitive data is exposed to unauthorized parties through logs, error messages, API responses, configuration leakage, or data store misconfigurations." },
              "help": {
                "text": "Review error response content, logging PII controls, access policies on data stores, and information leakage in response headers and bodies.",
                "markdown": "## Information Disclosure Threats\n\nReview error response content, logging PII controls, access policies on data stores, and information leakage in response headers and bodies.\n\n**References**: OWASP A01 (Broken Access Control), CWE-200 (Exposure of Sensitive Information to an Unauthorized Actor), GDPR Article 4(5) (Pseudonymisation requirements)"
              },
              "properties": {
                "tags": ["security", "stride", "information-disclosure", "data-exposure", "gdpr", "owasp", "cwe"],
                "security-severity": "8.0"
              },
