          "ruleId": "tachi/stride/spoofing",
          "message": {
            "text": "Voter UUID may be stolen via localStorage extraction by XSS, malicious extension, or browser compromise, enabling fraudulent vote casting on behalf of the victim.",
            "markdown": "Strengthen CSP to block inline scripts and restrict script-src to known origins; implement SRI on all frontend assets; consider supplementing UUID identity with a short-lived server-side session token."
          },
          "level": "warning",
          "locations": [
            {
              "physicalLocation": { "artifactLocation": { "uri": "docs/security/architecture.md" }, "region": { "startLine": 1 } },
              "logicalLocations": [{ "name": "User Browser", "fullyQualifiedName": "Public Internet/User Browser", "kind": "external-entity" }]
            }
