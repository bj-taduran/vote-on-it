                { "target": { "id": "CWE-200", "toolComponent": { "name": "CWE" } }, "kinds": ["relevant"] }
              ]
            },
            {
              "id": "tachi/stride/denial-of-service",
              "shortDescription": { "text": "Denial of service threats" },
              "fullDescription": { "text": "Threats where an attacker degrades or eliminates system availability by exhausting resources, overwhelming capacity limits, or exploiting dependency chains." },
              "help": {
                "text": "Review rate limiting configurations, DynamoDB capacity modes, Lambda concurrency limits, WAF rate-based rules, and dependency chain resilience.",
                "markdown": "## Denial of Service Threats\n\nReview rate limiting configurations, DynamoDB capacity modes, Lambda concurrency limits, WAF rate-based rules, and dependency chain resilience.\n\n**References**: OWASP A05 (Security Misconfiguration), CWE-400 (Uncontrolled Resource Consumption)"
              },
